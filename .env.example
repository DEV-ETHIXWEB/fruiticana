# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.fruiticana.com

# Sanity headless CMS: leave blank to run on the bundled seed content
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Editor token: used by `npm run seed` and to store form submissions in the Studio inbox
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity -> /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Contact + newsletter email delivery via Resend (optional if the Sanity token is set)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@fruiticana.com
CONTACT_FROM_EMAIL="Fruiticana Website <web@fruiticana.com>"
